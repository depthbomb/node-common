{
	"name": "@depthbomb/node-common",
	"version": "3.0.0",
	"author": "depthbomb",
	"description": "A set of common utilities and functions for Node.js",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"typescript",
		"nodejs",
		"utilities"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./appdirs": {
			"import": {
				"types": "./dist/appdirs.d.mts",
				"default": "./dist/appdirs.mjs"
			},
			"require": {
				"types": "./dist/appdirs.d.cts",
				"default": "./dist/appdirs.cjs"
			}
		},
		"./atomic": {
			"import": {
				"types": "./dist/atomic.d.mts",
				"default": "./dist/atomic.mjs"
			},
			"require": {
				"types": "./dist/atomic.d.cts",
				"default": "./dist/atomic.cjs"
			}
		},
		"./cancellation": {
			"import": {
				"types": "./dist/cancellation.d.mts",
				"default": "./dist/cancellation.mjs"
			},
			"require": {
				"types": "./dist/cancellation.d.cts",
				"default": "./dist/cancellation.cjs"
			}
		},
		"./lockfile": {
			"import": {
				"types": "./dist/lockfile.d.mts",
				"default": "./dist/lockfile.mjs"
			},
			"require": {
				"types": "./dist/lockfile.d.cts",
				"default": "./dist/lockfile.cjs"
			}
		},
		"./lifecycle": {
			"import": {
				"types": "./dist/lifecycle.d.mts",
				"default": "./dist/lifecycle.mjs"
			},
			"require": {
				"types": "./dist/lifecycle.d.cts",
				"default": "./dist/lifecycle.cjs"
			}
		},
		"./pathlib": {
			"import": {
				"types": "./dist/pathlib.d.mts",
				"default": "./dist/pathlib.mjs"
			},
			"require": {
				"types": "./dist/pathlib.d.cts",
				"default": "./dist/pathlib.cjs"
			}
		},
		"./platform": {
			"import": {
				"types": "./dist/platform.d.mts",
				"default": "./dist/platform.mjs"
			},
			"require": {
				"types": "./dist/platform.d.cts",
				"default": "./dist/platform.cjs"
			}
		},
		"./ports": {
			"import": {
				"types": "./dist/ports.d.mts",
				"default": "./dist/ports.mjs"
			},
			"require": {
				"types": "./dist/ports.d.cts",
				"default": "./dist/ports.cjs"
			}
		},
		"./process": {
			"import": {
				"types": "./dist/process.d.mts",
				"default": "./dist/process.mjs"
			},
			"require": {
				"types": "./dist/process.d.cts",
				"default": "./dist/process.cjs"
			}
		},
		"./streams": {
			"import": {
				"types": "./dist/streams.d.mts",
				"default": "./dist/streams.mjs"
			},
			"require": {
				"types": "./dist/streams.d.cts",
				"default": "./dist/streams.cjs"
			}
		},
		"./temp": {
			"import": {
				"types": "./dist/temp.d.mts",
				"default": "./dist/temp.mjs"
			},
			"require": {
				"types": "./dist/temp.d.cts",
				"default": "./dist/temp.cjs"
			}
		},
		"./watch": {
			"import": {
				"types": "./dist/watch.d.mts",
				"default": "./dist/watch.mjs"
			},
			"require": {
				"types": "./dist/watch.d.cts",
				"default": "./dist/watch.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/depthbomb/node-common.git"
	},
	"bugs": {
		"url": "https://github.com/depthbomb/node-common/issues"
	},
	"scripts": {
		"bench": "yarn build && node benchmark/benchmark.mjs",
		"bench:lines": "yarn build && node benchmark/lines.mjs",
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"dist": "yarn build",
		"release": "yarn dist && release-it",
		"lint": "oxlint ./src",
		"test": "vitest"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"oxlint": "^1.80.0",
		"release-it": "^21.0.2",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"packageManager": "yarn@4.18.0"
}
